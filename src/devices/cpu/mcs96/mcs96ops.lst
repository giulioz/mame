macro post_indirect $size $cycles1 $cycles2
	if(OPI & 0x01) {
		reg_w16(OPI, OP1 + $size);
		next($cycles2 + (is_196() && OP1 >= 0x100 ? ($cycles1 == 7 ? 3 : 2) : 0));
	} else {
		next($cycles1 + (is_196() && OP1 >= 0x100 ? ($cycles1 == 7 ? 3 : 2) : 0));
	}

macro post_indirect_196 $size $old_normal $old_inc $new_normal $new_inc $ext_normal $ext_inc
	if(OPI & 0x01) {
		reg_w16(OPI, OP1 + $size);
		next_196($old_inc, OP1 < 0x100 ? $new_inc : $ext_inc);
	} else {
		next_196($old_normal, OP1 < 0x100 ? $new_normal : $ext_normal);
	}

eadr  indexed_2b
	OPI = read_pc();
	OP1 = read_pc();
	if(OPI & 0x01) {
		OP1 |= read_pc() << 8;
	} else if(OP1 & 0x80)
		OP1 |= 0xff00;
	if(OPI) {
		OP1 += reg_r16(OPI);
	}
	OP2 = read_pc();

eadr  indexed_3b
	OPI = read_pc();
	OP1 = read_pc();
	if(OPI & 0x01) {
		OP1 |= read_pc() << 8;
	} else if(OP1 & 0x80)
		OP1 |= 0xff00;
	if(OPI) {
		OP1 += reg_r16(OPI);
	}
	OP2 = read_pc();
	OP3 = read_pc();

eadr  indexed_3e
	OPI = read_pc();
	OP1 = read_pc();
	if(OPI & 0x01) {
		OP1 |= read_pc() << 8;
	} else if(OP1 & 0x80)
		OP1 |= 0xff00;
	if(OPI) {
		OP1 += reg_r16(OPI);
	}
	OP2 = read_pc();
	OP3 = read_pc();

eadr  indexed_1w
	OPI = read_pc();
	OP1 = read_pc();
	if(OPI & 0x01) {
		OP1 |= read_pc() << 8;
	} else
		OP1 = int8_t(OP1);
	if(OPI) {
		OP1 += reg_r16(OPI);
	}

eadr  indexed_2w
	OPI = read_pc();
	OP1 = read_pc();
	if(OPI & 0x01) {
		OP1 |= read_pc() << 8;
	} else if(OP1 & 0x80)
		OP1 |= 0xff00;
	if(OPI) {
		OP1 += reg_r16(OPI);
	}
	OP2 = read_pc();

eadr  indexed_3w
	OPI = read_pc();
	OP1 = read_pc();
	if(OPI & 0x01) {
		OP1 |= read_pc() << 8;
	} else if(OP1 & 0x80)
		OP1 |= 0xff00;
	if(OPI) {
		OP1 += reg_r16(OPI);
	}
	OP2 = read_pc();
	OP3 = read_pc();

macro post_indexed $cycles1 $cycles2
	next((OPI & 0x01 ? $cycles2 : $cycles1) + (is_196() && OP1 >= 0x100 ? ($cycles1 == 7 ? 3 : 2) : 0));

macro post_indexed_196 $old_short $old_long $new_short $new_long $ext_short $ext_long
	next_196(OPI & 0x01 ? $old_long : $old_short, OPI & 0x01 ? (OP1 < 0x100 ? $new_long : $ext_long) : (OP1 < 0x100 ? $new_short : $ext_short));

00    skip  immed_1b
	next_196(4, 3);

01    clr   direct_1w
	set_nz16(0);
	reg_w16(OP1, 0x0000);
	next_196(4, 3);

02    not   direct_1w
	TMP = ~reg_r16(OP1);
	set_nz16(TMP);
	reg_w16(OP1, TMP);
	next_196(4, 3);

03    neg   direct_1w
	TMP = reg_r16(OP1);
	reg_w16(OP1, do_sub(0, TMP));
	next_196(4, 3);

05    dec   direct_1w
	TMP = reg_r16(OP1);
	reg_w16(OP1, do_sub(TMP, 1));
	next_196(4, 3);

06    ext   direct_1w
	OP1 &= 0xfc;
	TMP = int16_t(reg_r16(OP1));
	set_nz16(TMP);
	reg_w16(OP1+2, TMP >> 16);
	next(4);

07    inc   direct_1w
	TMP = reg_r16(OP1);
	reg_w16(OP1, do_add(TMP, 1));
	next_196(4, 3);

08    shr   immed_or_reg_2w
	TMP = reg_r16(OP2);
	PSW &= ~(F_Z|F_N|F_C|F_V|F_ST);
	if(OP1 >= 2 && (TMP & (0xffff >> (OP1 <= 16 ? 17-OP1 : 0))))
		PSW |= F_ST;
	if(OP1 >= 1 && OP1 <= 16 && (TMP & (0x0001 << (OP1-1))))
		PSW |= F_C;
	TMP = uint16_t(TMP) >> OP1;
	if(!TMP)
		PSW |= F_Z;
	else if(int16_t(TMP) < 0)
		PSW |= F_N;
	reg_w16(OP2, TMP);
	next_196(OP1 ? 7+OP1 : 8, OP1 ? 6+OP1 : 7);

09    shl   immed_or_reg_2w
	TMP = reg_r16(OP2);
	PSW &= ~(F_Z|F_N|F_C|F_V);
	if(OP1 >= 1 && OP1 <= 16 && (TMP & (0x8000 >> (OP1-1))))
		PSW |= F_C;
	set_shift_left_overflow(TMP, 16, OP1);
	TMP = uint16_t(TMP << OP1);
	if(!TMP)
		PSW |= F_Z;
	else if(int16_t(TMP) < 0)
		PSW |= F_N;
	reg_w16(OP2, TMP);
	next_196(OP1 ? 7+OP1 : 8, OP1 ? 6+OP1 : 7);

0a    shra  immed_or_reg_2w
	TMP = reg_r16(OP2);
	PSW &= ~(F_Z|F_N|F_C|F_V|F_ST);
	if(OP1 >= 2 && (TMP & (0xffff >> (OP1 <= 16 ? 17-OP1 : 0))))
		PSW |= F_ST;
	if(OP1 >= 1 && OP1 <= 16 && (TMP & (0x0001 << (OP1-1))))
		PSW |= F_C;
	else if(OP1 > 16 && (TMP & 0x8000))
		PSW |= F_C;
	TMP = int16_t(TMP) >> OP1;
	if(!TMP)
		PSW |= F_Z;
	else if(int16_t(TMP) < 0)
		PSW |= F_N;
	reg_w16(OP2, TMP);
	next_196(OP1 ? 7+OP1 : 8, OP1 ? 6+OP1 : 7);

0c    shrl  immed_or_reg_2w
	OP2 &= 0xfc;
	TMP = reg_r16(OP2);
	TMP |= uint32_t(reg_r16(OP2+2)) << 16;
	PSW &= ~(F_Z|F_N|F_C|F_V|F_ST);
	if(OP1 >= 2 && (TMP & (0xffffffff >> (33-OP1))))
		PSW |= F_ST;
	if(OP1 >= 1 && (TMP & (0x00000001 << (OP1-1))))
		PSW |= F_C;
	TMP = TMP >> OP1;
	if(!TMP)
		PSW |= F_Z;
	else if(int32_t(TMP) < 0)
		PSW |= F_N;
	reg_w16(OP2, TMP);
	reg_w16(OP2+2, TMP >> 16);
	next(OP1 ? 7+OP1 : 8);

0d    shll  immed_or_reg_2w
	OP2 &= 0xfc;
	TMP = reg_r16(OP2);
	TMP |= uint32_t(reg_r16(OP2+2)) << 16;
	PSW &= ~(F_Z|F_N|F_C|F_V);
	if(OP1 >= 1 && (TMP & (0x80000000 >> (OP1-1))))
		PSW |= F_C;
	set_shift_left_overflow(TMP, 32, OP1);
	TMP = TMP << OP1;
	if(!TMP)
		PSW |= F_Z;
	else if(int32_t(TMP) < 0)
		PSW |= F_N;
	reg_w16(OP2, TMP);
	reg_w16(OP2+2, TMP >> 16);
	next(OP1 ? 7+OP1 : 8);

0e    shral immed_or_reg_2w
	OP2 &= 0xfc;
	TMP = reg_r16(OP2);
	TMP |= uint32_t(reg_r16(OP2+2)) << 16;
	PSW &= ~(F_Z|F_N|F_C|F_V|F_ST);
	if(OP1 >= 2 && (TMP & (0xffffffff >> (33-OP1))))
		PSW |= F_ST;
	if(OP1 >= 1 && (TMP & (0x00000001 << (OP1-1))))
		PSW |= F_C;
	TMP = int32_t(TMP) >> OP1;
	if(!TMP)
		PSW |= F_Z;
	else if(int32_t(TMP) < 0)
		PSW |= F_N;
	reg_w16(OP2, TMP);
	reg_w16(OP2+2, TMP >> 16);
	next(OP1 ? 7+OP1 : 8);

0f    norml direct_2e
	OP2 &= 0xfc;
	TMP = reg_r16(OP2);
	TMP |= uint32_t(reg_r16(OP2+2)) << 16;
	for(OP3 = 0; OP3 < 31 && int32_t(TMP) >= 0; TMP <<= 1, OP3++);
	PSW &= ~(F_Z|F_N|F_C);
	if(!TMP)
		PSW |= F_Z;
	else if(int32_t(TMP) < 0)
		PSW |= F_N;
	reg_w8(OP1, OP3);
	reg_w16(OP2, TMP);
	reg_w16(OP2+2, TMP >> 16);
	next_196(11+OP3, OP3 ? 8+OP3 : 9);

11    clrb  direct_1b
	set_nz8(0);
	reg_w8(OP1, 0x00);
	next_196(4, 3);

12    notb  direct_1b
	TMP = ~reg_r8(OP1);
	set_nz8(TMP);
	reg_w8(OP1, TMP);
	next_196(4, 3);

13    negb  direct_1b
	TMP = reg_r8(OP1);
	reg_w8(OP1, do_subb(0, TMP));
	next_196(4, 3);

15    decb  direct_1b
	TMP = reg_r8(OP1);
	reg_w8(OP1, do_subb(TMP, 1));
	next_196(4, 3);

16    extb  direct_1b
	OP1 &= 0xfe;
	TMP = int8_t(reg_r8(OP1));
	set_nz8(TMP);
	reg_w16(OP1, TMP);
	next(4);

17    incb  direct_1b
	TMP = reg_r8(OP1);
	reg_w8(OP1, do_addb(TMP, 1));
	next_196(4, 3);

18    shrb  immed_or_reg_2b
	TMP = reg_r8(OP2);
	PSW &= ~(F_Z|F_N|F_C|F_V|F_ST);
	if(OP1 >= 2 && (TMP & (0xff >> (OP1 <= 8 ? 9-OP1 : 0))))
		PSW |= F_ST;
	if(OP1 >= 1 && OP1 <= 8 && (TMP & (0x01 << (OP1-1))))
		PSW |= F_C;
	TMP = uint8_t(TMP) >> OP1;
	if(!TMP)
		PSW |= F_Z;
	else if(int8_t(TMP) < 0)
		PSW |= F_N;
	reg_w8(OP2, TMP);
	next_196(OP1 ? 7+OP1 : 8, OP1 ? 6+OP1 : 7);

19    shlb  immed_or_reg_2b
	TMP = reg_r8(OP2);
	PSW &= ~(F_Z|F_N|F_C|F_V);
	if(OP1 >= 1 && OP1 <= 8 && (TMP & (0x80 >> (OP1-1))))
		PSW |= F_C;
	set_shift_left_overflow(TMP, 8, OP1);
	TMP = uint8_t(TMP << OP1);
	if(!TMP)
		PSW |= F_Z;
	else if(int8_t(TMP) < 0)
		PSW |= F_N;
	reg_w8(OP2, TMP);
	next_196(OP1 ? 7+OP1 : 8, OP1 ? 6+OP1 : 7);

1a    shrab immed_or_reg_2b
	TMP = reg_r8(OP2);
	PSW &= ~(F_Z|F_N|F_C|F_V|F_ST);
	if(OP1 >= 2 && (TMP & (0xff >> (OP1 <= 8 ? 9-OP1 : 0))))
		PSW |= F_ST;
	if(OP1 >= 1 && OP1 <= 8 && (TMP & (0x01 << (OP1-1))))
		PSW |= F_C;
	else if(OP1 > 8 && (TMP & 0x80))
		PSW |= F_C;
	TMP = uint8_t(int8_t(TMP) >> OP1);
	if(!TMP)
		PSW |= F_Z;
	else if(int8_t(TMP) < 0)
		PSW |= F_N;
	reg_w8(OP2, TMP);
	next_196(OP1 ? 7+OP1 : 8, OP1 ? 6+OP1 : 7);

20-27 sjmp  rel11
	PC += OP1;
	next_196(8, 7);

28-2f scall rel11
	TMP = reg_r16(0x18);
	TMP -= 2;
	reg_w16(0x18, TMP);
	any_w16(TMP, PC);
	PC += OP1;
	next_196(13, TMP < 0x100 ? 11 : 13);

30-37 jbc   brrel8
	TMP = reg_r8(OP2);
	if(!((TMP >> (inst_state & 7)) & 1)) {
		PC += OP1;
		next(9);
	} else {
		next(5);
	}

38-3f jbs   brrel8
	TMP = reg_r8(OP2);
	if((TMP >> (inst_state & 7)) & 1) {
		PC += OP1;
		next(9);
	} else {
		next(5);
	}

40    and   direct_3w
	TMP = reg_r16(OP1);
	TMP &= reg_r16(OP2);
	set_nz16(TMP);
	reg_w16(OP3, TMP);
	next(5);

41    and   immed_3w
	TMP = OP1 & reg_r16(OP2);
	set_nz16(TMP);
	reg_w16(OP3, TMP);
	next(6);

42    and   indirect_3w
	TMP = any_r16(OP1);
	TMP &= reg_r16(OP2);
	set_nz16(TMP);
	reg_w16(OP3, TMP);
	post_indirect 2 7 8 // +5 when external

43    and   indexed_3w
	TMP = any_r16(OP1);
	TMP &= reg_r16(OP2);
	set_nz16(TMP);
	reg_w16(OP3, TMP);
	post_indexed 7 8 // +5 when external

44    add   direct_3w
	TMP = reg_r16(OP1);
	TMP = do_add(reg_r16(OP2), TMP);
	reg_w16(OP3, TMP);
	next(5);

45    add   immed_3w
	TMP = do_add(reg_r16(OP2), OP1);
	reg_w16(OP3, TMP);
	next(6);

46    add   indirect_3w
	TMP = any_r16(OP1);
	TMP = do_add(reg_r16(OP2), TMP);
	reg_w16(OP3, TMP);
	post_indirect 2 7 8 // +5 when external

47    add   indexed_3w
	TMP = any_r16(OP1);
	TMP = do_add(reg_r16(OP2), TMP);
	reg_w16(OP3, TMP);
	post_indexed 7 8 // +5 when external

48    sub   direct_3w
	TMP = reg_r16(OP1);
	TMP = do_sub(reg_r16(OP2), TMP);
	reg_w16(OP3, TMP);
	next(5);

49    sub   immed_3w
	TMP = do_sub(reg_r16(OP2), OP1);
	reg_w16(OP3, TMP);
	next(6);

4a    sub   indirect_3w
	TMP = any_r16(OP1);
	TMP = do_sub(reg_r16(OP2), TMP);
	reg_w16(OP3, TMP);
	post_indirect 2 7 8 // +5 when external

4b    sub   indexed_3w
	TMP = any_r16(OP1);
	TMP = do_sub(reg_r16(OP2), TMP);
	reg_w16(OP3, TMP);
	post_indexed 7 8 // +5 when external

4c    mulu  direct_3w
	TMP = reg_r16(OP1);
	TMP *= reg_r16(OP2);
	OP3 &= 0xfc;
	reg_w16(OP3, TMP);
	reg_w16(OP3+2, TMP >> 16);
	next_196(26, 14);

4d    mulu  immed_3w
	TMP = OP1 * reg_r16(OP2);
	OP3 &= 0xfc;
	reg_w16(OP3, TMP);
	reg_w16(OP3+2, TMP >> 16);
	next_196(27, 15);

4e    mulu  indirect_3w
	TMP = any_r16(OP1);
	TMP *= reg_r16(OP2);
	OP3 &= 0xfc;
	reg_w16(OP3, TMP);
	reg_w16(OP3+2, TMP >> 16);
	post_indirect_196 2 28 29 16 17 19 19

4f    mulu  indexed_3w
	TMP = any_r16(OP1);
	TMP *= reg_r16(OP2);
	OP3 &= 0xfc;
	reg_w16(OP3, TMP);
	reg_w16(OP3+2, TMP >> 16);
	post_indexed_196 28 29 17 18 20 21

fe4c  mul   direct_3w
	TMP = reg_r16(OP1);
	TMP = int16_t(reg_r16(OP2)) * int16_t(TMP);
	OP3 &= 0xfc;
