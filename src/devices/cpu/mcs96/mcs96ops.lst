	PSW |= F_I;
	check_irq();
	next_noirq_196(4, 2);

fc    clrvt none
	PSW &= ~F_VT;
	next_196(4, 2);

fd    nop   none
	next_196(4, 2);

ff    rst   none
	device_reset();
	next_noirq_196(4, 15);
