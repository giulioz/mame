<?xml version="1.0"?>
<!-- Yamaha EX5R rack panel.  Coordinates follow the physical three-unit faceplate. -->
<mamelayout version="2">
	<element name="panel"><rect><color red="0.08" green="0.10" blue="0.20" /></rect></element>
	<element name="well"><rect><color red="0.025" green="0.03" blue="0.05" /></rect></element>
	<element name="button" defstate="0">
		<rect><color state="0" red="0.16" green="0.17" blue="0.20" /><color state="1" red="0.45" green="0.48" blue="0.58" /></rect>
	</element>
	<element name="knob"><disk><color red="0.30" green="0.31" blue="0.36" /></disk></element>
	<element name="knob_value"><simplecounter maxstate="1023" digits="4"><color red="0.78" green="0.82" blue="0.90" /></simplecounter></element>
	<element name="logo"><text string="YAMAHA"><color red="0.88" green="0.90" blue="0.96" /></text></element>
	<element name="model"><text string="EX5R"><color red="0.88" green="0.90" blue="0.96" /></text></element>

	<element name="txt_sc2"><text string="SC2" /></element><element name="txt_sc1"><text string="SC1" /></element>
	<element name="txt_voice"><text string="VOICE" /></element><element name="txt_perform"><text string="PERFORM" /></element>
	<element name="txt_song"><text string="SONG" /></element><element name="txt_pattern"><text string="PATTERN" /></element>
	<element name="txt_sample"><text string="SAMPLE" /></element><element name="txt_utility"><text string="UTILITY" /></element>
	<element name="txt_disk"><text string="DISK" /></element><element name="txt_edit"><text string="EDIT/COMPARE" /></element>
	<element name="txt_job"><text string="JOB" /></element><element name="txt_store"><text string="STORE" /></element>
	<element name="txt_arpeg"><text string="ARPEG" /></element><element name="txt_knobmode"><text string="KNOB" /></element>
	<element name="txt_keymap"><text string="KEYMAP" /></element><element name="txt_bypass"><text string="BYPASS" /></element>
	<element name="txt_shift"><text string="SHIFT" /></element><element name="txt_f1"><text string="F1" /></element>
	<element name="txt_f2"><text string="F2" /></element><element name="txt_f3"><text string="F3" /></element>
	<element name="txt_f4"><text string="F4" /></element><element name="txt_f5"><text string="F5" /></element>
	<element name="txt_f6"><text string="F6" /></element><element name="txt_f7"><text string="F7" /></element>
	<element name="txt_f8"><text string="F8" /></element><element name="txt_exit"><text string="EXIT" /></element>
	<element name="txt_cancel"><text string="CANCEL" /></element><element name="txt_data"><text string="CURSOR/DATA" /></element>
	<element name="txt_dec"><text string="DEC/NO" /></element><element name="txt_inc"><text string="INC/YES" /></element>
	<element name="txt_up"><text string="UP" /></element><element name="txt_left"><text string="LEFT" /></element>
	<element name="txt_down"><text string="DOWN" /></element><element name="txt_right"><text string="RIGHT" /></element>
	<element name="txt_top"><text string="TOP" /></element><element name="txt_rew"><text string="REW" /></element>
	<element name="txt_fwd"><text string="FWD" /></element><element name="txt_rec"><text string="REC" /></element>
	<element name="txt_stop"><text string="STOP" /></element><element name="txt_play"><text string="PLAY" /></element>
	<element name="txt_0"><text string="0" /></element><element name="txt_1"><text string="1" /></element>
	<element name="txt_2"><text string="2" /></element><element name="txt_3"><text string="3" /></element>
	<element name="txt_4"><text string="4" /></element><element name="txt_5"><text string="5" /></element>
	<element name="txt_6"><text string="6" /></element><element name="txt_7"><text string="7" /></element>
	<element name="txt_8"><text string="8" /></element><element name="txt_9"><text string="9" /></element>
	<element name="txt_minus"><text string="-" /></element><element name="txt_enter"><text string="ENTER" /></element>

	<group name="panel_button">
		<bounds x="0" y="0" width="60" height="42" />
		<element ref="txt_~label~"><bounds x="0" y="0" width="60" height="10" /></element>
		<element ref="button" inputtag="~input~" inputmask="~mask~"><bounds x="7" y="12" width="46" height="28" /></element>
	</group>
	<group name="controller_knob">
		<bounds x="0" y="0" width="64" height="72" />
		<element ref="knob" inputtag="~input~" inputmask="0x3ff" inputraw="yes"><bounds x="6" y="0" width="52" height="52" /></element>
		<element ref="knob_value" inputtag="~input~" inputmask="0x3ff" inputraw="yes"><bounds x="11" y="54" width="42" height="12" /></element>
	</group>

	<view name="Rack Panel">
		<bounds x="0" y="0" width="1800" height="520" />
		<element ref="panel"><bounds x="0" y="0" width="1800" height="520" /></element>
		<element ref="logo"><bounds x="110" y="25" width="190" height="36" /></element>
		<element ref="model"><bounds x="930" y="20" width="220" height="48" /></element>
		<element ref="well"><bounds x="590" y="70" width="600" height="355" /></element>
		<screen index="0"><bounds x="625" y="95" width="530" height="141" /></screen>

		<!-- Mode and utility block -->
		<param name="input" value="PANEL0"/><param name="mask" value="0x04"/><param name="label" value="voice"/><group ref="panel_button"><bounds x="110" y="105" width="62" height="44"/></group>
		<param name="mask" value="0x08"/><param name="label" value="perform"/><group ref="panel_button"><bounds x="178" y="105" width="62" height="44"/></group>
		<param name="mask" value="0x10"/><param name="label" value="song"/><group ref="panel_button"><bounds x="246" y="105" width="62" height="44"/></group>
		<param name="mask" value="0x20"/><param name="label" value="pattern"/><group ref="panel_button"><bounds x="314" y="105" width="62" height="44"/></group>
		<param name="mask" value="0x40"/><param name="label" value="sample"/><group ref="panel_button"><bounds x="382" y="105" width="62" height="44"/></group>
		<param name="mask" value="0x01"/><param name="label" value="sc2"/><group ref="panel_button"><bounds x="450" y="105" width="62" height="44"/></group>

		<param name="input" value="PANEL1"/><param name="mask" value="0x02"/><param name="label" value="edit"/><group ref="panel_button"><bounds x="110" y="160" width="62" height="44"/></group>
		<param name="mask" value="0x04"/><param name="label" value="job"/><group ref="panel_button"><bounds x="178" y="160" width="62" height="44"/></group>
		<param name="mask" value="0x08"/><param name="label" value="store"/><group ref="panel_button"><bounds x="246" y="160" width="62" height="44"/></group>
		<param name="input" value="PANEL0"/><param name="mask" value="0x80"/><param name="label" value="utility"/><group ref="panel_button"><bounds x="314" y="160" width="62" height="44"/></group>
		<param name="input" value="PANEL1"/><param name="mask" value="0x01"/><param name="label" value="disk"/><group ref="panel_button"><bounds x="382" y="160" width="62" height="44"/></group>
		<param name="input" value="PANEL0"/><param name="mask" value="0x02"/><param name="label" value="sc1"/><group ref="panel_button"><bounds x="450" y="160" width="62" height="44"/></group>

		<param name="input" value="PANEL1"/><param name="mask" value="0x10"/><param name="label" value="arpeg"/><group ref="panel_button"><bounds x="382" y="230" width="62" height="44"/></group>
		<param name="mask" value="0x20"/><param name="label" value="knobmode"/><group ref="panel_button"><bounds x="450" y="230" width="62" height="44"/></group>
		<param name="input" value="PANEL2"/><param name="mask" value="0x02"/><param name="label" value="keymap"/><group ref="panel_button"><bounds x="382" y="285" width="62" height="44"/></group>
		<param name="mask" value="0x04"/><param name="label" value="bypass"/><group ref="panel_button"><bounds x="450" y="285" width="62" height="44"/></group>

		<!-- LCD soft keys -->
		<param name="input" value="PANEL2"/><param name="mask" value="0x40"/><param name="label" value="shift"/><group ref="panel_button"><bounds x="610" y="248" width="52" height="44"/></group>
		<param name="mask" value="0x80"/><param name="label" value="f1"/><group ref="panel_button"><bounds x="666" y="248" width="52" height="44"/></group>
		<param name="input" value="PANEL3"/><param name="mask" value="0x01"/><param name="label" value="f2"/><group ref="panel_button"><bounds x="722" y="248" width="52" height="44"/></group>
		<param name="mask" value="0x02"/><param name="label" value="f3"/><group ref="panel_button"><bounds x="778" y="248" width="52" height="44"/></group>
		<param name="mask" value="0x04"/><param name="label" value="f4"/><group ref="panel_button"><bounds x="834" y="248" width="52" height="44"/></group>
		<param name="mask" value="0x08"/><param name="label" value="f5"/><group ref="panel_button"><bounds x="890" y="248" width="52" height="44"/></group>
		<param name="mask" value="0x10"/><param name="label" value="f6"/><group ref="panel_button"><bounds x="946" y="248" width="52" height="44"/></group>
		<param name="mask" value="0x20"/><param name="label" value="f7"/><group ref="panel_button"><bounds x="1002" y="248" width="52" height="44"/></group>
		<param name="mask" value="0x40"/><param name="label" value="f8"/><group ref="panel_button"><bounds x="1058" y="248" width="52" height="44"/></group>
		<param name="mask" value="0x80"/><param name="label" value="exit"/><group ref="panel_button"><bounds x="1114" y="248" width="52" height="44"/></group>

		<param name="input" value="KNOB1"/><group ref="controller_knob"><bounds x="640" y="325" width="70" height="78"/></group>
		<param name="input" value="KNOB2"/><group ref="controller_knob"><bounds x="725" y="325" width="70" height="78"/></group>
		<param name="input" value="KNOB3"/><group ref="controller_knob"><bounds x="810" y="325" width="70" height="78"/></group>
		<param name="input" value="KNOB4"/><group ref="controller_knob"><bounds x="895" y="325" width="70" height="78"/></group>
		<param name="input" value="KNOB5"/><group ref="controller_knob"><bounds x="980" y="325" width="70" height="78"/></group>
		<param name="input" value="KNOB6"/><group ref="controller_knob"><bounds x="1065" y="325" width="70" height="78"/></group>

		<!-- Data entry, transport and keypad -->
		<param name="input" value="PANEL4"/><param name="mask" value="0x01"/><param name="label" value="cancel"/><group ref="panel_button"><bounds x="1220" y="75" width="66" height="44"/></group>
		<param name="mask" value="0x02"/><param name="label" value="data"/><group ref="panel_button"><bounds x="1220" y="130" width="66" height="44"/></group>
		<element ref="knob" inputtag="encoder" inputmask="0xff" inputraw="yes"><bounds x="1310" y="65" width="130" height="130"/></element>
		<param name="mask" value="0x04"/><param name="label" value="dec"/><group ref="panel_button"><bounds x="1220" y="195" width="58" height="44"/></group>
		<param name="mask" value="0x08"/><param name="label" value="up"/><group ref="panel_button"><bounds x="1280" y="195" width="58" height="44"/></group>
		<param name="mask" value="0x10"/><param name="label" value="inc"/><group ref="panel_button"><bounds x="1340" y="195" width="58" height="44"/></group>
		<param name="mask" value="0x20"/><param name="label" value="left"/><group ref="panel_button"><bounds x="1220" y="245" width="58" height="44"/></group>
		<param name="mask" value="0x40"/><param name="label" value="down"/><group ref="panel_button"><bounds x="1280" y="245" width="58" height="44"/></group>
		<param name="mask" value="0x80"/><param name="label" value="right"/><group ref="panel_button"><bounds x="1340" y="245" width="58" height="44"/></group>

		<param name="input" value="PANEL1"/><param name="mask" value="0x40"/><param name="label" value="top"/><group ref="panel_button"><bounds x="1220" y="310" width="58" height="44"/></group>
		<param name="mask" value="0x80"/><param name="label" value="rew"/><group ref="panel_button"><bounds x="1280" y="310" width="58" height="44"/></group>
		<param name="input" value="PANEL2"/><param name="mask" value="0x01"/><param name="label" value="fwd"/><group ref="panel_button"><bounds x="1340" y="310" width="58" height="44"/></group>
		<param name="mask" value="0x08"/><param name="label" value="rec"/><group ref="panel_button"><bounds x="1220" y="365" width="58" height="44"/></group>
		<param name="mask" value="0x10"/><param name="label" value="stop"/><group ref="panel_button"><bounds x="1280" y="365" width="58" height="44"/></group>
		<param name="mask" value="0x20"/><param name="label" value="play"/><group ref="panel_button"><bounds x="1340" y="365" width="58" height="44"/></group>

		<param name="input" value="PANEL5"/><param name="mask" value="0x01"/><param name="label" value="7"/><group ref="panel_button"><bounds x="1480" y="150" width="56" height="44"/></group>
		<param name="mask" value="0x02"/><param name="label" value="8"/><group ref="panel_button"><bounds x="1540" y="150" width="56" height="44"/></group>
		<param name="mask" value="0x04"/><param name="label" value="9"/><group ref="panel_button"><bounds x="1600" y="150" width="56" height="44"/></group>
		<param name="mask" value="0x08"/><param name="label" value="4"/><group ref="panel_button"><bounds x="1480" y="205" width="56" height="44"/></group>
		<param name="mask" value="0x10"/><param name="label" value="5"/><group ref="panel_button"><bounds x="1540" y="205" width="56" height="44"/></group>
		<param name="mask" value="0x20"/><param name="label" value="6"/><group ref="panel_button"><bounds x="1600" y="205" width="56" height="44"/></group>
		<param name="mask" value="0x40"/><param name="label" value="1"/><group ref="panel_button"><bounds x="1480" y="260" width="56" height="44"/></group>
		<param name="mask" value="0x80"/><param name="label" value="2"/><group ref="panel_button"><bounds x="1540" y="260" width="56" height="44"/></group>
		<param name="input" value="PANEL6"/><param name="mask" value="0x01"/><param name="label" value="3"/><group ref="panel_button"><bounds x="1600" y="260" width="56" height="44"/></group>
		<param name="mask" value="0x02"/><param name="label" value="0"/><group ref="panel_button"><bounds x="1480" y="315" width="56" height="44"/></group>
		<param name="mask" value="0x04"/><param name="label" value="minus"/><group ref="panel_button"><bounds x="1540" y="315" width="56" height="44"/></group>
		<param name="mask" value="0x08"/><param name="label" value="enter"/><group ref="panel_button"><bounds x="1600" y="315" width="56" height="44"/></group>
	</view>
</mamelayout>
