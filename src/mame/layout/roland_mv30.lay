		<element ref="script_warning" id="warning"><bounds x="924" y="852" width="540" height="13"/></element>
	</view>

	<script><![CDATA[
		-- Faders (incl. VOLUME) are dragged directly; the VALUE dial turns by
		-- pulsing the driver's Value -/+ inputs, one detent per pulse.
		file:set_resolve_tags_callback(
			function()
				local view = file.views["Front Panel"]
				local function field_of(tag)
					local port = file.device:ioport(tag)
					for _, f in pairs(port.fields) do return f end
				end
				local faders = {}
				for i = 0, 8 do
					faders[#faders + 1] = {
						area = view.items["fader" .. i],
						cap = view.items["fadercap" .. i],
						field = field_of(i < 8 and ("FADER" .. i) or "VOLUME") }
				end
				local dial = view.items["dial"]
				local dimple = view.items["dial_dimple"]
				local value = file.device:ioport("VALUE")
				local dec, inc = value.fields["Value -"], value.fields["Value +"]
				local dial_port = file.device:ioport("DIAL")
				local STEP = math.pi / 9 -- 18 detents per turn
				local drag, pending, pulsing, turned = nil, 0, nil, 0

				local function angle(x, y)
					local b = dial.bounds
					return math.atan(y - (b.y0 + b.y1) / 2, x - (b.x0 + b.x1) / 2)
				end

				view:set_pointer_updated_callback(
					function(type, id, dev, x, y, btn, dn, up, cnt)
						if btn & 1 == 0 then
							drag = nil
							return
						end
						if dn & 1 ~= 0 then
							drag = nil
							for _, f in ipairs(faders) do
								if f.area.bounds:includes(x, y) then
									drag = { fader = f }
								end
							end
							if not drag and dial.bounds:includes(x, y) then
								drag = { angle = angle(x, y), sweep = 0 }
							end
						end
						if not drag then
							return
						elseif drag.fader then
							local area, cap = drag.fader.area.bounds, drag.fader.cap.bounds.height
							local v = (area.y1 - 4 - cap / 2 - y) / (area.height - 8 - cap) * 100
							drag.fader.field.user_value = math.max(0, math.min(100, math.floor(v + 0.5)))
						else
							local a = angle(x, y)
							local d = a - drag.angle
							if d > math.pi then d = d - 2 * math.pi elseif d < -math.pi then d = d + 2 * math.pi end
							drag.angle = a
							drag.sweep = drag.sweep + d
							while drag.sweep >= STEP do pending = pending + 1; drag.sweep = drag.sweep - STEP end
							while drag.sweep <= -STEP do pending = pending - 1; drag.sweep = drag.sweep + STEP end
						end
					end)
				local function release() drag = nil end
				view:set_pointer_left_callback(release)
				view:set_pointer_aborted_callback(release)
				view:set_forget_pointers_callback(release)

				-- One press or release per frame, so the 1 kHz panel scan sees every detent.
				view:set_prepare_items_callback(
					function()
						if pulsing then
							pulsing:set_value(0)
							pulsing = nil
						elseif pending ~= 0 then
							pulsing = pending > 0 and inc or dec
							pulsing:set_value(1)
							turned = turned + (pending > 0 and 1 or -1)
							pending = pending - (pending > 0 and 1 or -1)
						end
					end)

				-- The dimple follows mouse detents and the host DIAL input.
				local db, mb = dial.bounds, dimple.bounds
				local cx, cy = (db.x0 + db.x1) / 2, (db.y0 + db.y1) / 2
				local dx, dy = (mb.x0 + mb.x1) / 2 - cx, (mb.y0 + mb.y1) / 2 - cy
				local r, w, h = math.sqrt(dx * dx + dy * dy), mb.width, mb.height
				local base = math.atan(dy, dx)
				dimple:set_bounds_callback(
					function()
						local a = base + (turned + dial_port:read()) * STEP
						local x, y = cx + r * math.cos(a), cy + r * math.sin(a)
						return emu.render_bounds(x - w / 2, y - h / 2, x + w / 2, y + h / 2)
					end)

				view.items["warning"]:set_state(0)
			end)
	]]></script>
</mamelayout>
